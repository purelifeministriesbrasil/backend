# ==============================================================================
# Pure Life Ministries Brasil — variáveis para os SCRIPTS Node (migrations, caixa pastoral)
# ==============================================================================
# O Worker NÃO lê este arquivo: em dev ele usa .dev.vars (veja .dev.vars.example) e em
# produção usa [vars] do wrangler.toml + `wrangler secret put`.
# Exporte no shell antes de rodar os scripts; nunca commite valores reais.

# Usado por `pnpm db:migrate` e `scripts/pastoral-inbox.mjs`.
# Para migrations prefira a conexão DIRETA ou "Session pooler" (porta 5432) do Supabase.
DATABASE_URL=postgresql://postgres.SEU_PROJETO:SENHA@aws-0-sa-east-1.pooler.supabase.com:5432/postgres

# Usados apenas pela caixa pastoral (decifra localmente e audita cada leitura).
TRIAGE_KEY_V1=
OPERATOR=nome.sobrenome@purelifebrasil.org

# Testes de integração contra um Postgres DESCARTÁVEL (as tabelas são truncadas!).
TEST_DATABASE_URL=postgresql://postgres@127.0.0.1:54329/postgres
