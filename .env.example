# ==============================================================================
# Pure Life Ministries Brasil — Variáveis de Ambiente do Backend Worker (Template)
# ==============================================================================
# Para desenvolvimento local com Wrangler:
# Copie este arquivo para .dev.vars (ou .env): cp .env.example .dev.vars

# Origem permitida para requisições CORS
PUBLIC_SITE_ORIGIN=http://localhost:4321

# Ambiente de execução (development | production)
ENVIRONMENT=development

# Conexão direta com PostgreSQL / Supabase
# Obtido em: Painel Supabase -> Project Settings -> Database -> Connection String (URI - Session mode pooler ou direto)
DATABASE_URL=postgresql://postgres.exemplo:[SENHA]@aws-0-sa-east-1.pooler.supabase.com:5432/postgres

# Chave Criptográfica AES-256 (32 bytes codificados em Base64) para dados confessionais
# Gerar chave segura: openssl rand -base64 32
TRIAGE_KEY_V1=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=

# Gateway de Pagamento Asaas (PIX Dinâmico)
# Chave de API de Sandbox ou Produção
ASAAS_API_KEY=$aact_exemplo_sandbox_token...
ASAAS_WEBHOOK_SECRET=segredo_webhook_configurado_no_asaas

# Cloudflare Turnstile Secret Key (Server-Side)
# Chave de teste sempre aprovada: 1x0000000000000000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Resend API Key (Notificações Pastorais por E-mail)
RESEND_API_KEY=re_exemplo_123456789
