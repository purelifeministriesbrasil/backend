{
  "name": "purelife-api",
  "version": "1.0.0",
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint src && node ./scripts/verify-boundaries.mjs",
    "verify:boundaries": "node ./scripts/verify-boundaries.mjs",
    "db:migrate": "node ./scripts/migrate.mjs",
    "db:migrate:dry-run": "node ./scripts/migrate.mjs --dry-run",
    "verify": "pnpm lint && pnpm typecheck && pnpm test",
    "verify:pnpm": "node ./scripts/verify-package-manager.mjs"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.17",
    "postgres": "^3.4.9",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250224.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.21.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^3.0.7",
    "wrangler": "^4.159.0"
  }
}
